// The Cloudflare Worker that serves dist/, the built site, as static assets. It has no Worker script.
// Workers Builds runs `npm ci --ignore-scripts && npm run build`, then `npx wrangler@4.151.0 deploy` on main and
// `npx wrangler@4.151.0 preview` on every other branch. The site is served at its workers.dev address and each
// preview at its own preview URL. A custom domain or route is a go-live step that needs the owner's OK, so none is
// set here. PP_ENV is unset on every build, so every page carries noindex until go-live sets it for main.
// There is no `previews` block: it is optional, and only overrides settings for preview deployments.
{
  "name": "paid-and-penalized",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // A path with no file gets the nearest 404.html, with status 404, as serve.js does.
    "not_found_handling": "404-page",
    // Cloudflare's default, named here so a change of default can't move the pages' addresses.
    "html_handling": "auto-trailing-slash"
  }
}

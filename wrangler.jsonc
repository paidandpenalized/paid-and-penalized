// The Cloudflare Worker that serves dist/, the built site, as static assets. It has no Worker script.
// Workers Builds runs `npm ci --ignore-scripts && npm run build`, then `npx wrangler@4.151.0 deploy` on main. Its
// deployment is served at the custom domain, paidandpenalized.org, and nowhere else: no workers.dev address and no
// preview URLs. Preview builds of other branches (`npx wrangler@4.151.0 preview`) are off in the dashboard; turning them
// back on means preview_urls: true here too. Main's build is the production build (buildEnv in
// pipeline/site/context.js), the only one search engines may index; every other build carries noindex.
{
  "name": "paid-and-penalized",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // `wrangler preview` requires this block (kept for when previews return); an empty one means previews use the
  // top-level settings.
  "previews": {},
  // The domain is the zone's apex; Cloudflare manages its DNS record and certificate. The .com and www redirects are
  // the zone's own rules, not this Worker's.
  "routes": [{ "pattern": "paidandpenalized.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // A path with no file gets the root 404.html, with status 404, as serve.js does.
    "not_found_handling": "404-page",
    // Cloudflare's default, named here so a change of default can't move the pages' addresses. address.js lookup
    // models it for the local server and the checks.
    "html_handling": "auto-trailing-slash"
  }
}

  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "rollup": {
      "description": "Totals over the hospitals counted (exposure roll-up): dollars are whole-dollar sums to 6 places; margins, shares and percent changes are fractions recomputed from the sums (null when the denominator is zero); counts are hospitals. `falls_1pp`: hospitals losing a point or more of operating margin; `into_red`: hospitals whose total margin goes from non-negative to negative.",
      "type": "object",
      "required": [
        "at_risk",
        "lost",
        "lost_cost",
        "added_uncompensated",
        "care_avoided",
        "other_coverage",
        "income_change",
        "hospitals",
        "exposed",
        "medicaid_revenue",
        "uncompensated_cost",
        "uc_added_where_reported",
        "margin_hospitals",
        "into_red",
        "falls_1pp",
        "operating_margin",
        "operating_margin_after",
        "total_margin",
        "total_margin_after",
        "net_patient_revenue",
        "lost_share_of_medicaid",
        "lost_share_of_at_risk",
        "uncompensated_change"
      ],
      "additionalProperties": false,
      "properties": {
        "at_risk": {
          "type": "number"
        },
        "lost": {
          "type": "number"
        },
        "lost_cost": {
          "type": "number"
        },
        "added_uncompensated": {
          "type": "number"
        },
        "care_avoided": {
          "type": "number"
        },
        "other_coverage": {
          "type": "number"
        },
        "income_change": {
          "type": "number"
        },
        "hospitals": {
          "type": "integer",
          "minimum": 0
        },
        "exposed": {
          "type": "integer",
          "minimum": 0
        },
        "medicaid_revenue": {
          "type": "number"
        },
        "uncompensated_cost": {
          "type": "number"
        },
        "uc_added_where_reported": {
          "type": "number"
        },
        "margin_hospitals": {
          "type": "integer",
          "minimum": 0
        },
        "into_red": {
          "type": "integer",
          "minimum": 0
        },
        "falls_1pp": {
          "type": "integer",
          "minimum": 0
        },
        "operating_margin": {
          "type": [
            "number",
            "null"
          ]
        },
        "operating_margin_after": {
          "type": [
            "number",
            "null"
          ]
        },
        "total_margin": {
          "type": [
            "number",
            "null"
          ]
        },
        "total_margin_after": {

          "type": [
            "number",
            "null"
          ]
        },
        "lost_share_of_at_risk": {
          "type": [
            "number",
            "null"
          ]
        },
        "uncompensated_change": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },

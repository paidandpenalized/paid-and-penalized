{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medicaid.schema.json",
  "title": "Medicaid work-requirement scenarios: modeled exposure of each acute and critical access hospital, FY2023 cost reports",
  "description": "MODELED, not reported. Three scenarios (Urban Institute's high, medium and low state mitigation, as low, middle and high losses) applied to each hospital's FY2023 Medicaid revenue (HCRIS S-10 line 2) through its state's CMS-64 VIII share, in 2023 dollars (method: docs/METHODS-LOG.md, `medicaid`). `fy` is the HCRIS base year. Per-hospital values are rounded: dollars to whole dollars, ratios and shares to 6 places; roll-ups are computed from unrounded values and rounded to 6 places. A hospital row is an array in `columns` order; the browser reruns steps 1 to 4 from the base fields, and the `middle_*` columns are the middle scenario's results at the default use rate, for figures drawn at build time. Maryland (class all_payer) and hospitals without a scenario carry no `middle_*` values and are left out of the national, group and sensitivity roll-ups.",
  "type": "object",
  "required": [
    "schema_version",
    "methods_version",
    "source_manifest",
    "sources",
    "built_at",
    "fy",
    "scenarios",
    "params",
    "hcris",
    "states",
    "national",
    "groups",
    "sensitivities",
    "columns",
    "hospitals"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "methods_version": {
      "$ref": "common.schema.json#/$defs/methodsVersion"
    },
    "source_manifest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "built_at": {
      "$ref": "common.schema.json#/$defs/builtAt"
    },
    "fy": {
      "description": "The HCRIS base year the scenario is built on (cost reports beginning in FY2023).",
      "const": 2023
    },
    "scenarios": {
      "description": "The three scenarios, low to high losses. `urban`: the Urban Institute / RWJF (March 2026) Appendix Table A.2 column each reads; `decline_enrollment`: Urban's national total decline in expansion enrollment (all 42 rows of Table A.2), in thousands of people; `decline_enrollment_scenario_states`: the part in states with a scenario, same unit.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "urban",
          "decline_enrollment",
          "decline_enrollment_scenario_states"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "low",
              "middle",
              "high"
            ]
          },
          "urban": {
            "enum": [
              "wr_high_mitigation",
              "wr_medium_mitigation",
              "wr_low_mitigation"
            ]
          },
          "decline_enrollment": {
            "type": "integer",
            "minimum": 0
          },
          "decline_enrollment_scenario_states": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "params": {
      "description": "The method's constants (pp_engine/medicaid/params.py), each with its source there.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_year",
        "uninsured_share",
        "care_still_used",

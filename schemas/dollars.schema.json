{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dollars.schema.json",
  "title": "Dollar estimates: what Medicare pays each hospital for the year, and what HRRP, HVBP and the HAC Reduction Program move",
  "description": "A model, not a bill (docs/METHODS-LOG.md, dollars). One row per hospital in the HACRP file, in whole dollars that add exactly; dollar keys exist only on rows whose status is estimated. The checks hold the national sums against what CMS publishes.",
  "type": "object",
  "required": [
    "schema_version",
    "methods_version",
    "source_manifest",
    "sources",
    "built_at",
    "fy",
    "assumptions",
    "national",
    "headline",
    "checks",
    "hospitals",
    "bands"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "methods_version": {
      "$ref": "common.schema.json#/$defs/methodsVersion"
    },
    "source_manifest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "built_at": {
      "$ref": "common.schema.json#/$defs/builtAt"
    },
    "fy": {
      "$ref": "common.schema.json#/$defs/fy"
    },
    "assumptions": {
      "$ref": "#/$defs/assumptions"
    },
    "national": {
      "description": "Sums over every estimated hospital.",
      "$ref": "#/$defs/totals"
    },
    "headline": {
      "description": "The same sums over the hospitals CMS scored and marked Yes or No: the population the HACRP site's headline counts.",
      "$ref": "#/$defs/totals"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "hospitals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hospital"
      }
    },
    "bands": {
      "description": "Back-tested ranges; null until the back-test (milestone 3).",
      "type": "null"
    }
  },
  "$defs": {
    "count": {
      "description": "A whole number that is never negative: a number of hospitals or bills, or a payment in whole dollars.",
      "type": "integer",
      "minimum": 0
    },
    "wholeDollars": {
      "description": "An amount in whole dollars, negative for money lost.",
      "type": "integer"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratesFy",
        "volumeFy",
        "mdhEnd",
        "lowVolumeEnd",
        "ntap"
      ],
      "properties": {
        "ratesFy": {
          "$ref": "common.schema.json#/$defs/fy"
        },
        "volumeFy": {
          "$ref": "common.schema.json#/$defs/fy"
        },
        "mdhEnd": {
          "$ref": "#/$defs/isoDate"
        },
        "lowVolumeEnd": {
          "$ref": "#/$defs/isoDate"
        },
        "ntap": {
          "const": "excluded"
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hospitals",
        "base",
        "total",
        "hrrp",
        "hvbp",
        "after",
        "hac",
        "net",
        "cut",
        "hrrpBase",
        "vbpBase",
        "yes",
        "yesUnestimated",
        "byStatus",
        "parts"
      ],
      "properties": {
        "hospitals": {
          "description": "Estimated hospitals: the sums below cover these only.",
          "$ref": "#/$defs/count"
        },
        "base": {
          "$ref": "#/$defs/count"
        },
        "total": {
          "$ref": "#/$defs/count"
        },
        "hrrp": {
          "description": "Sum of HRRP dollars (a loss: not above zero).",
          "$ref": "#/$defs/wholeDollars",
          "maximum": 0
        },
        "hvbp": {
          "$ref": "#/$defs/wholeDollars"
        },
        "after": {
          "$ref": "#/$defs/count"
        },
        "hac": {
          "description": "Sum of HAC dollars (a loss: not above zero).",
          "$ref": "#/$defs/wholeDollars",
          "maximum": 0
        },
        "net": {
          "$ref": "#/$defs/wholeDollars"
        },
        "cut": {
          "description": "Estimated hospitals the HAC Reduction Program cuts.",
          "$ref": "#/$defs/count"
        },
        "hrrpBase": {
          "description": "Sum of the base payment over the penalized hospitals: the base the HRRP share check divides by.",
          "$ref": "#/$defs/count"
        },
        "vbpBase": {
          "description": "Sum of the base payment over the hospitals in Table 16B: the base the HVBP check uses.",
          "$ref": "#/$defs/count"
        },
        "yes": {
          "description": "Hospitals the HAC Reduction Program cuts, whether or not estimated.",
          "$ref": "#/$defs/count"
        },
        "yesUnestimated": {
          "description": "Cut hospitals with no estimate.",
          "$ref": "#/$defs/count"
        },
        "byStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimated",
            "maryland",
            "parhm",
            "no-inputs"
          ],
          "properties": {
            "estimated": {
              "$ref": "#/$defs/count"
            },
            "maryland": {
              "$ref": "#/$defs/count"
            },
            "parhm": {
              "$ref": "#/$defs/count"
            },
            "no-inputs": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "parts": {
          "description": "The sum of each part over the estimated hospitals.",
          "$ref": "#/$defs/parts"
        }
      }
    },
    "parts": {
      "description": "What the payment is made of, whole dollars: the federal DRG payment (fed), the Medicare-dependent hospital add-on, indirect medical education, disproportionate share, operating outliers, the sole community hospital difference, the low-volume adjustment, capital and uncompensated care. Base = fed + mdhAddon; total = base + the rest.",
      "type": "object",
      "required": [
        "fed",
        "mdhAddon",
        "ime",
        "dsh",
        "outlierOp",
        "schDiff",
        "lowVolume",
        "capital",
        "uc"
      ],
      "additionalProperties": false,
      "properties": {
        "fed": {
          "$ref": "#/$defs/count"
        },
        "mdhAddon": {
          "$ref": "#/$defs/count"
        },
        "ime": {
          "$ref": "#/$defs/count"
        },
        "dsh": {
          "$ref": "#/$defs/count"
        },
        "outlierOp": {
          "$ref": "#/$defs/count"
        },
        "schDiff": {
          "$ref": "#/$defs/count"
        },
        "lowVolume": {
          "$ref": "#/$defs/count"
        },
        "capital": {
          "$ref": "#/$defs/count"
        },
        "uc": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "low",
        "high",
        "pass"
      ],
      "properties": {
        "id": {
          "enum": [
            "hrrp_share",
            "vbp_net",
            "hac_share",
            "hac_count",
            "yes_unestimated"
          ]
        },
        "value": {
          "description": "null when there is nothing to divide by (the check then fails).",
          "type": [
            "number",
            "null"
          ]
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "pass": {
          "type": "boolean"
        }
      }
    },
    "hospital": {
      "description": "A row has the five bare keys; an estimated row has every key (the emitter's golden test checks that the dollar keys are on estimated rows only, which this schema's keywords cannot express).",
      "type": "object",
      "required": [
        "ccn",
        "status",
        "cut",
        "hrrpListed",
        "vbpListed"
      ],
      "additionalProperties": false,
      "properties": {
        "ccn": {
          "$ref": "common.schema.json#/$defs/ccn"
        },
        "status": {
          "description": "estimated, or why there is no estimate: maryland (paid under the state's own model), parhm (Pennsylvania Rural Health Model), no-inputs (no usable row in the impact file).",
          "enum": [
            "estimated",
            "maryland",
            "parhm",
            "no-inputs"
          ]
        },
        "cut": {
          "description": "CMS's HAC Reduction Program decision is Yes.",
          "type": "boolean"
        },
        "cases": {
          "description": "Transfer-adjusted Medicare cases in the impact file (FY2024 volume).",
          "type": "number",
          "minimum": 0
        },
        "bills": {
          "description": "Medicare bills in the impact file.",
          "$ref": "#/$defs/count"
        },
        "base": {
          "description": "B: the federal DRG payment plus the Medicare-dependent hospital add-on.",
          "$ref": "#/$defs/count"
        },
        "total": {
          "description": "T: B plus the other parts.",
          "$ref": "#/$defs/count"
        },
        "hrrpFactor": {
          "description": "The HRRP payment adjustment factor (1 where the hospital is not in the HRRP file).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vbpFactor": {
          "description": "The HVBP adjustment factor (1 where the hospital is not in Table 16B).",
          "type": "number",
          "minimum": 0
        },
        "hrrpListed": {
          "type": "boolean"
        },
        "vbpListed": {
          "type": "boolean"
        },
        "hrrp": {
          "description": "B x (hrrpFactor - 1): a loss, not above zero.",
          "$ref": "#/$defs/wholeDollars",
          "maximum": 0
        },
        "hvbp": {
          "description": "B x (vbpFactor - 1): negative for a penalty, positive for a bonus.",
          "$ref": "#/$defs/wholeDollars"
        },
        "after": {
          "description": "T after the HRRP and HVBP dollars.",
          "$ref": "#/$defs/count"
        },
        "atStake": {
          "description": "1% of `after`, for every hospital: the dollars at risk in the HAC Reduction Program.",
          "$ref": "#/$defs/count"
        },
        "hac": {
          "description": "-atStake when the hospital is cut, else 0.",
          "$ref": "#/$defs/wholeDollars",
          "maximum": 0
        },
        "net": {
          "description": "hrrp + hvbp + hac.",
          "$ref": "#/$defs/wholeDollars"
        },
        "parts": {
          "$ref": "#/$defs/parts"
        }
      }
    }
  }
}

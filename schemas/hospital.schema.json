{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hospital.schema.json",
  "title": "The hospital master: one record per CCN, shared by every site",
  "$defs": {
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inProgram",
        "reason"
      ],
      "properties": {
        "inProgram": {
          "type": "boolean",
          "description": "Subject to the program's payment adjustment for its file year (hospital methods_version 2)."
        },
        "reason": {
          "description": "null when inProgram; otherwise the first rule that explains why not (docs/METHODS-LOG.md, hospital methods_version 2).",
          "enum": [
            null,
            "critical_access",
            "psychiatric",
            "childrens",
            "long_term",
            "rural_emergency",
            "federal",
            "maryland",
            "inactive",
            "not_listed"
          ]
        }
      }
    },
    "hospital": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ccn",
        "name",
        "alias",
        "street",
        "city",
        "state",
        "zip",
        "county",
        "fips",
        "lat",
        "lon",
        "geo",
        "cbsa",
        "cbsaName",
        "region",
        "division",
        "kind",
        "ipps",
        "types",
        "teach",
        "urban",
        "beds",
        "bedsSource",
        "own",
        "ownDetail",
        "inactive",
        "programs"
      ],
      "properties": {
        "ccn": {
          "$ref": "common.schema.json#/$defs/ccn"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The impact file's name when it differs materially from the shown name."
        },
        "street": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "city": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "zip": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{5}$"
        },
        "county": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The county or independent city, with its legal suffix (docs/METHODS-LOG.md, hospital methods_version 2)."
        },
        "fips": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{5}$",
          "description": "The impact file's FIPS county code."
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "geo": {
          "description": "Where lat/lon came from: a geocoded street address, the ZIP centroid, or a county centroid; null with no point.",
          "enum": [
            null,
            "address",
            "zip",
            "county"
          ]
        },
        "cbsa": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{5}$",
          "description": "The impact file's geographic labor market area, when it is a 5-digit CBSA."
        },
        "cbsaName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "region": {
          "enum": [
            null,
            "Northeast",
            "Midwest",
            "South",
            "West"
          ]
        },
        "division": {
          "enum": [
            null,
            "New England",
            "Middle Atlantic",
            "East North Central",
            "West North Central",
            "South Atlantic",
            "East South Central",
            "West South Central",
            "Mountain",
            "Pacific"
          ]
        },
        "kind": {
          "enum": [
            "acute",
            "critical_access",
            "psychiatric",
            "childrens",
            "long_term",
            "rural_emergency",
            "va",
            "dod",
            "unknown"
          ]
        },
        "ipps": {
          "description": "Listed in the IPPS impact file.",
          "type": "boolean"
        },
        "types": {
          "type": "array",
          "items": {
            "enum": [
              "EACH",
              "IHS",
              "MDH",
              "RRC",
              "SCH"
            ]
          }
        },
        "teach": {
          "enum": [
            null,
            "none",
            "minor",
            "major"
          ]
        },
        "urban": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "beds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "bedsSource": {
          "description": "pos: certified beds (Provider of Services); cr: cost-report beds (impact file).",
          "enum": [
            null,
            "pos",
            "cr"
          ]
        },
        "own": {
          "enum": [
            null,
            "Government",
            "For-profit",
            "Nonprofit",
            "Unknown"
          ]
        },
        "ownDetail": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "inactive": {
          "description": "Set when Provider of Services shows Medicare participation ended.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "date",
            "reason"
          ],
          "properties": {
            "date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "programs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hacrp",
            "hrrp"
          ],
          "properties": {
            "hacrp": {
              "$ref": "#/$defs/program"
            },
            "hrrp": {
              "$ref": "#/$defs/program"
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "methods_version",
    "source_manifest",
    "sources",
    "built_at",
    "fy",
    "programYears",
    "hospitals"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "methods_version": {
      "$ref": "common.schema.json#/$defs/methodsVersion"
    },
    "source_manifest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "built_at": {
      "$ref": "common.schema.json#/$defs/builtAt"
    },
    "fy": {
      "$ref": "common.schema.json#/$defs/fy"
    },
    "programYears": {
      "description": "Each program's file year (fiscal year of the CMS file that set inProgram).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hacrp",
        "hrrp"
      ],
      "properties": {
        "hacrp": {
          "$ref": "common.schema.json#/$defs/fy"
        },
        "hrrp": {
          "$ref": "common.schema.json#/$defs/fy"
        }
      }
    },
    "hospitals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hospital"
      }
    }
  }
}
